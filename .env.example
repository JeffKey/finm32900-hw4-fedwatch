# Copy this file to .env and fill in your values. The .env file is
# gitignored -- never commit credentials.

# Databento -- get a key at https://databento.com (Account > API keys).
# The data used in this project is free under the course's Databento
# subscription. (The pull script double-checks this before downloading
# anything, so running it will never incur a charge.)
DATABENTO_API_KEY=

# Optional overrides for the pull window (YYYY-MM-DD).
# Defaults: trailing 180 days through today.
# START_DATE=
# END_DATE=
